#---------------------------------------------------------------------
# HAProxy configuration template
# Deploy as /etc/haproxy/haproxy.cfg (after variable substitution)
# Same file on ALL nodes — HAProxy only becomes active where the VIP lives
#---------------------------------------------------------------------

global
    log /dev/log    local0
    log /dev/log    local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

    # SSL tuning
    ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256
    ssl-default-bind-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    option  forwardfor
    option  http-server-close

    timeout connect 5000ms
    timeout client  50000ms
    timeout server  50000ms
    timeout http-request 10s
    timeout http-keep-alive 10s

    # Error files
    errorfile 400 /etc/haproxy/errors/400.http
    errorfile 403 /etc/haproxy/errors/403.http
    errorfile 408 /etc/haproxy/errors/408.http
    errorfile 500 /etc/haproxy/errors/500.http
    errorfile 502 /etc/haproxy/errors/502.http
    errorfile 503 /etc/haproxy/errors/503.http
    errorfile 504 /etc/haproxy/errors/504.http

#---------------------------------------------------------------------
# Stats endpoint — useful for monitoring / alerting
# Access at http://<VIP>/haproxy?stats (or http://<node-ip>:8404)
#---------------------------------------------------------------------
listen stats
    bind *:8404
    mode http
    stats enable
    stats uri /haproxy?stats
    stats refresh 10s
    stats admin if LOCALHOST

#---------------------------------------------------------------------
# Frontend: accept HTTPS traffic for the floating VIP
# TLS terminates here, traffic is forwarded to backends over HTTP
#---------------------------------------------------------------------
frontend backend_https
    # Listen on all interfaces (the VIP is assigned locally by keepalived)
    bind *:8006 ssl crt /etc/haproxy/certs/backend.pem

    # Default to HTTPS redirect for non-HTTPS clients
    http-request redirect scheme https unless { ssl_fc }

    # Use the first healthy backend
    default_backend backend_nodes

#---------------------------------------------------------------------
# Frontend: also accept plain HTTP (redirect to HTTPS)
#---------------------------------------------------------------------
frontend backend_http
    bind *:8007
    http-request redirect scheme https code 301

#---------------------------------------------------------------------
# Backend: backend servers
# - roundrobin distributes across healthy nodes
# - Health checks verify each backend is reachable
# - Customize the health check path for your service
#---------------------------------------------------------------------
backend backend_nodes
    balance roundrobin

    # Stickiness for session-based services (optional — uncomment if needed)
    # cookie SERVERID insert indirect nocache

    # Health check — customize for your service
    # Example: GET /health, expect 200
    # Example: GET /api, expect 200 or 401
    option httpchk GET /
    http-check expect status 200,401

    # Disable SSL verification for self-signed certs
    # 'none' means HAProxy does not verify the backend cert
    default-server ssl verify none ca-file none

    # Health check parameters
    inter ${HC_INTERVAL} rise 2 fall 3

    # --- Backend nodes from config.sh ---
${BACKENDS_DIRECTIVE}

#---------------------------------------------------------------------
# If stickiness is preferred for session-based services, use this
# cookie-based stickiness backend instead of roundrobin above
#---------------------------------------------------------------------
# backend backend_nodes_sticky
#     balance roundrobin
#     cookie SERVERID insert indirect nocache
#     default-server ssl verify none ca-file none
