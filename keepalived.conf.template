#!/usr/bin/env bash
# =============================================================================
# Keepalived configuration template
# Generated by merging config.sh + node.conf → /etc/keepalived/keepalived.conf
# =============================================================================

# Global settings
global_defs {
    router_id LBA_${VRRP_INTERFACE//\./_}    # Unique per interface, not per node
    # enable_script_security          # Uncomment if running under strict security
    # script_user root                # Uncomment with enable_script_security

    # Email notifications (optional)
    # notification_email {
    #     ${ALERT_EMAIL}
    # }
    # notification_email_from keepalived@localhost
    # smtp_server ${SMTP_SERVER:-127.0.0.1}
    # smtp_connect_timeout 30
}

vrrp_nosync

vrrp_script chk_haproxy {
    script "/usr/local/bin/ha-check-haproxy.sh"
    interval 2
    weight ${HA_PROXY_WEIGHT}
    fall 2
    rise 2
}

vrrp_instance VIP_${VRRP_VRID} {
    state ${INITIAL_STATE}
    interface ${VRRP_INTERFACE}
    virtual_router_id ${VRRP_VRID}

    # --- Priority: set from node.conf (primary=110, backups=90) ---
    priority ${NODE_PRIORITY}

    # VRRP multicast source (must be this node's IP)
    multicast_src ${NODE_IP}

    # Advertisements every second
    advert_int 1

    # Authentication — prevent rogue VRRP packets
    authentication {
        auth_type PASS
        auth_pass CHANGE_ME_PASSWORD
    }

    # The floating VIP
    virtual_ipaddress {
        ${VIP_ADDRESS}/${VIP_SUBNET}
    }

    # Track the HAProxy health check script
    track_script {
        chk_haproxy
    }

    # Only accept VRRP packets from trusted peers (optional but recommended)
    # allow ${TRUSTED_PEER_1}
    # allow ${TRUSTED_PEER_2}

    # Lower priority when HAProxy dies (handled by chk_haproxy weight)
    # If HAProxy is down: priority drops by 20 (110→90 or 90→70)
    # Another node with higher priority will take over
}
